# Local terraform directory
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude double-start backups
*.backup

# Override variables
*.tfvars
*.tfvars.json

# Local history / IDE files
.idea/
.vscode/
.DS_Store

# Ignore credentials and logs
*.pem
*.log
